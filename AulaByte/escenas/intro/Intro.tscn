[node name="intro" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_a1g7d")
imagenes = Array[Texture2D]([ExtResource("2_ixy36"), ExtResource("3_ftjmw"), ExtResource("4_g86wm"), ExtResource("5_iwusb"), ExtResource("6_k5goc"), ExtResource("6_k5goc"), ExtResource("7_p8utp")])
textos = Array[String](["En la hermosa ciudad de San Juan de Pasto, en la Universidad de Nariño, conviven cuatro grandes profesores, que dedicaban su vida a enseñar.", "Un día, explorando los rincones olvidados del antiguo laboratorio de informática, buscando componentes viejos,", "descubrieron un extraño computador, que al encender cobró vida una inteligencia artificial llamada CUY, creada con propósitos de aprender, enseñar y evolucionar mediante la lógica.", "Los docentes, inspirados por su potencial, iniciaron el PROYECTO Jurguillas , una misión secreta para terminar de entrenar a CUY mediante ejercicios de razonamiento lógico, con el fin de implementarla como un sistema de seguridad y un asistente virtual para todo el edificio.", "Sin embargo, el Instituto TecnoIdiático(terco de ideas fijas), (una organización educativa privada obsesionada con la tecnología) descubrió el proyecto y robo información para tener el control de la IA con un virus llamado “Yorasite”, transformando el edificio en un laberinto lleno de errores y trampas,", "CUY quedó atrapado entre líneas de código desordenado, sus funciones divididas y su memoria fragmentada.", "Ahora, los profesores deberán adentrarse en el edificio, resolver los desafíos lógicos y desinfectar el núcleo de CUY, antes de que sea controlada para siempre."])
audios = Array[AudioStream]([ExtResource("8_scrrw"), ExtResource("9_njy6h"), ExtResource("10_h7dml"), ExtResource("11_7jwf3"), ExtResource("12_qsk8r"), null])

