config_version=5

[application]

config/name="AulaByte"
config/version="1.0.2"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="uid://dmoqu2apkie6"

[autoload]

MusicaGlobal="*res://scripts/musica_global.gd"
GameManager="*res://scripts/jugador/game_manager.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="viewport"

[global_group]

