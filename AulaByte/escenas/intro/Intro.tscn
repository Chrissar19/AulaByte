script = ExtResource("1_a1g7d")
imagenes = Array[Texture2D]([ExtResource("2_ixy36"), ExtResource("3_ftjmw"), ExtResource("4_g86wm"), ExtResource("5_iwusb"), ExtResource("5_iwusb"), ExtResource("6_k5goc"), ExtResource("6_k5goc"), ExtResource("6_k5goc"), ExtResource("7_p8utp")])
textos = Array[String](["En la hermosa ciudad de San Juan de Pasto, en la Universidad de Nariño, conviven cuatro grandes profesores, que dedicaban su vida a enseñar. ", "Un día, explorando los rincones olvidados del laboratorio de informática en busca decomponentes antiguos,", "descubrieron un extraño computador que, al encenderlo, activó una inteligencia artificial llamada Cuy, creada con el propósito de enseñar yevolucionar mediante la lógica.", "Los docentes, inspirados por su potencial, iniciaron el PROYECTO Jurguillas , una misión secreta para terminar de entrenar a CUY mediante ejercicios de razonamiento lógico,", "con el fin de implementarla como un sistema de seguridad y un asistente virtual para todo el edificio.", "Sin embargo, el Instituto TecnoIdiático descubrió el proyecto y...", "y robó información para tener elcontrol de la IA con un virus llamadoYorasite, transformando el edificio en unlaberinto lleno de errores y trampas,", "CUY quedó atrapado entre líneas de código desordenado, sus funciones divididas y su memoria fragmentada.", "Ahora, los profesores deberán entrar en eledificio, resolver los desafíos lógicos ydesinfectar el núcleo de Cuy, antes de quesea controlada por Yorasite."])
audios = Array[AudioStream]([ExtResource("8_qsk8r"), ExtResource("9_kx5a5"), ExtResource("10_w2dd5"), ExtResource("11_m83nb"), ExtResource("12_7vphg"), ExtResource("13_5qfeo"), ExtResource("14_e0yaj"), ExtResource("15_0f2re"), ExtResource("16_vx50f")])

