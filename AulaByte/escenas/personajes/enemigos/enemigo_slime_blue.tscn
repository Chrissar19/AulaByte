[sub_resource type="GDScript" id="GDScript_ivgsn"]
script/source = "extends CharacterBody2D

#--variables exportadas
@export var velocidad: float = 40.0
@export var vel_persecucion := 70.0
@export var dmg: int = 1 #-- DMG = el daño que realiza el enemigo damage
@export var gravedad: float = 400.0
@export var rango_deteccion: float = 200.0
@export var fuerza_rebote: float = -500.0 #-- rebota al jugador cuando salta sobre el

#-- Variables internas
var direccion := 1
var jugador_detectado: Node2D = null

#-- Nodos
@onready var ray_cast_arriba: RayCast2D = $RayCastArriba
@onready var ray_cast_der: RayCast2D = $RayCastDerecha
@onready var ray_cast_izq: RayCast2D = $RayCastIzquierda
@onready var sensor_dano: Area2D = $SensorDaño
@onready var sprite: AnimatedSprite2D = $AnimatedSprite2D
@onready var sonido_slime_walk: AudioStreamPlayer2D = $SonidoSlimeWalk
@onready var sonido_slime_death: AudioStreamPlayer2D = $SonidoSlimeDeath
@onready var colision_dmg: CollisionShape2D = $Muerte/ColisionDMG
@onready var muerte: Area2D = $Muerte

func _ready() -> void:
	add_to_group(\"Enemigos\") #--Grupo para los enemigos
	sensor_dano.body_entered.connect(_al_tocar_jugador)
	muerte.body_entered.connect(_golpe_desde_arriba)
	
func _physics_process(delta: float) -> void:
	#--Aplicar gravedad
	if not is_on_floor():
		velocity.y += gravedad * delta
	else:
		velocity.y = 0
		
	#-- Buscar jugadores cercanos
	detectar_jugador()
	#-- Movimientos
	if jugador_detectado:
		mover_hacia_jugador()
	else:
		patrullar()
	move_and_slide()
	
#----------------------------------------------------------------------------------------------
#-- MOVIMIENTOS
#----------------------------------------------------------------------------------------------
func patrullar() -> void:
	if ray_cast_der.is_colliding():
		direccion = -1
		sprite.flip_h = true
	elif ray_cast_izq.is_colliding():
		direccion = 1
		sprite.flip_h = false
	velocity.x = direccion * velocidad
	
func mover_hacia_jugador() -> void:
	var dir = sign(jugador_detectado.global_position.x - global_position.x)
	direccion = dir
	sprite.flip_h = direccion < 0
	velocity.x = direccion * vel_persecucion
	
#---------------------------------------------------------------------------------------------
#-- DETECTAR AL JUGADOR
#--------------------------------------------------------------------------------------------
func detectar_jugador() -> void:
	var jugadores = get_tree().get_nodes_in_group(\"Jugador\")
	for jugador in jugadores:
		if jugador and jugador.global_position.distance_to(global_position) <= rango_deteccion:
			jugador_detectado = jugador
			return
	jugador_detectado = null
	
#----------------------------------------------------------------------------------------------
#-- COLISIONES CON EL JUGADOR
#----------------------------------------------------------------------------------------------
func _al_tocar_jugador(nodo: Node2D) -> void:
	if not nodo.is_in_group(\"Jugador\"):
		nodo.recibir_dmg()
		
func _golpe_desde_arriba(cuerpo: Node2D) -> void:
	if cuerpo.is_in_group(\"Jugador\"):
		morir(cuerpo)
	
#-----------------------------------------------------------------------------------------------
#-- MUERTE DE SLIME
#---------------------------------------------------------------------------------------------
func morir(jugador: Node2D) -> void:
	jugador.velocity.y = fuerza_rebote
	jugador.ganar_puntos(2)
	
	sonido_slime_death.play()
	sprite.play(\"slime_death_blue\")
	
	colision_dmg.disabled = true
	sensor_dano.monitoring = false
	muerte.monitoring = false
	
	await get_tree().create_timer(0.3).timeout
	queue_free()
"

